<?xml version="1.0"?>
<package format="3">
  <name>course_simulation</name>
  <version>0.1.0</version>
  <description>PR07 headless Gazebo simulation and command/odometry adapters.</description>
  <maintainer email="a.pozdnyakov1@g.nsu.ru">owner</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
